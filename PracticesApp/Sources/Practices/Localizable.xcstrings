{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%lld projects · %lld repositories · %lld services · %lld ignored": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "проектов: %lld · репозиториев: %lld · сервисов: %lld · игнорируется: %lld"
          }
        }
      }
    },
    "%lld runs": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld прогонов"
          }
        }
      }
    },
    "%lld uncommitted": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "не закоммичено: %lld"
          }
        }
      }
    },
    "A registry secret is written in a file. Move it out and delete the copy.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Секрет из реестра записан в файле. Уберите его оттуда."
          }
        }
      }
    },
    "A service that wants a taken port fails on `docker compose up`. Under OrbStack it answers at service.project.orb.local without publishing the port.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис, которому нужен занятый порт, не поднимется на `docker compose up`. В OrbStack он доступен как service.project.orb.local без публикации порта."
          }
        }
      }
    },
    "Accept": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принять"
          }
        }
      }
    },
    "Accept all": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принять всё"
          }
        }
      }
    },
    "Add one with `practicesctl service add <id> --project <project>`.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте первый: `practicesctl service add <id> --project <project>`."
          }
        }
      }
    },
    "Ahead of and behind its upstream, as the last fetch left it": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опережение и отставание от upstream — по состоянию на последний fetch"
